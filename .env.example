# Copy to .env.local and fill in. Never commit .env.local.

# Required for `npm run pipeline` and Live mode.
ANTHROPIC_API_KEY=

# Model used by every LLM agent.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional cheaper model for the Filter Agent only. Falls back to ANTHROPIC_MODEL.
ANTHROPIC_MODEL_FILTER=claude-haiku-5-5

# Passphrase required to use "Run live". When empty, Live mode only works on a
# local dev server (npm run dev); a deployment refuses every live run.
LIVE_MODE_PASSPHRASE=
