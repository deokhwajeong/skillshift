{
  "name": "skillshift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:data": "tsx scripts/check-data.ts",
    "pipeline": "tsx scripts/run-pipeline.ts",
    "sample": "tsx scripts/make-sample.ts && tsx scripts/live-cache.ts --sample && tsx scripts/live-cache.ts --sample --weak && tsx scripts/eval.ts",
    "live:cache": "tsx scripts/live-cache.ts",
    "eval": "tsx scripts/eval.ts",
    "zip": "tsx scripts/zip.ts",
    "build:demo": "STATIC_EXPORT=1 NEXT_PUBLIC_STATIC_DEMO=1 next build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "gray-matter": "^4.0.3",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
